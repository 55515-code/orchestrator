"use strict";
/**
 * Substrate Vault — OpenClaw Control UI plugin.
 *
 * Mounts the Substrate credential vault into the OpenClaw Control UI as a
 * sidebar tab ("Vault"). The vault state lives in the Substrate workspace
 * (state/credentials.enc, keyring-backed via CredentialStore) and this
 * plugin exposes a thin HTTP API on the Gateway so the sandboxed tab can
 * read/write secrets WITHOUT ever exposing raw secret values to the
 * browser — only masked previews and metadata are returned.
 */

const http = require("node:http");
const path = require("node:path");
const fs = require("node:fs");
const crypto = require("node:crypto");

const WORKSPACE = "/home/node/.openclaw/workspace";
const STATE_DIR = path.join(WORKSPACE, "state");
const STATIC_DIR = __dirname + "/static";
const VAULT_CREDENTIALS = path.join(STATE_DIR, "credentials.enc");
const VAULT_STATE = path.join(STATE_DIR, "integrations-state.json");
const CATALOG_PATH = path.join(WORKSPACE, "integrations.yaml");
const AUDIT_PATH = path.join(STATE_DIR, "crypto", "audit.jsonl");

const PLUGIN_TOKEN = process.env.SUBSTRATE_VAULT_PLUGIN_TOKEN || "dev";
// Hard cap so we never accept a >8 KiB secret through the HTTP surface.
const MAX_BODY = 16 * 1024;

let _cached = null;
function credentialsFile() {
  const raw = fs.existsSync(VAULT_CREDENTIALS) ? fs.readFileSync(VAULT_CREDENTIALS, "utf8") : "{}";
  try {
    return JSON.parse(raw);
  } catch {
    return {};
  }
}

function stateFile() {
  const raw = fs.existsSync(VAULT_STATE) ? fs.readFileSync(VAULT_STATE, "utf8") : "{}";
  try {
    return JSON.parse(raw);
  } catch {
    return { connections: {} };
  }
}

function writeState(state) {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  const tmp = VAULT_STATE + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(state, null, 2));
  fs.renameSync(tmp, VAULT_STATE);
}

function audit(action, details) {
  try {
    fs.mkdirSync(path.dirname(AUDIT_PATH), { recursive: true });
    const prev = fs.existsSync(AUDIT_PATH) ? fs.readFileSync(AUDIT_PATH, "utf8").trim().split("\n").filter(Boolean).pop() : null;
    const prevHash = prev ? JSON.parse(prev).hash : "0".repeat(64);
    const entry = {
      seq: (prev ? JSON.parse(prev).seq : 0) + 1,
      timestamp: new Date().toISOString(),
      actor: "substrate-vault-plugin",
      action,
      tier: action === "credential_accessed" ? 0 : 1,
      details,
      prev_hash: prevHash,
    };
    entry.hash = crypto.createHash("sha256").update(JSON.stringify({ ...entry, hash: undefined })).digest("hex");
    fs.appendFileSync(AUDIT_PATH, JSON.stringify(entry) + "\n");
  } catch {
    /* audit must never break the vault */
  }
}

function maskedPreview(secret) {
  if (!secret) return "—";
  const s = String(secret);
  if (s.length <= 4) return "••••";
  return "••••••••" + s.slice(-2);
}

function fingerprint(secret) {
  if (!secret) return null;
  return crypto.createHash("sha256").update(String(secret)).digest("hex").slice(0, 8);
}

// --- Secret storage (mirrors substrate/vault.py semantics) ---------------
// Raw secrets are ONLY stored in the Fernet-encrypted credentials file
// (or OS keyring when available). The state JSON holds opaque pointers.
function storeSecret(serviceId, secret, authMethod, mode) {
  const enc = credentialsFile();
  const key = `integration:${serviceId}`;
  enc[key] = { value: secret, auth_method: authMethod || null, mode: mode || "read", updated_at: new Date().toISOString() };
  fs.writeFileSync(VAULT_CREDENTIALS, JSON.stringify(enc));
  // state pointer (never the value)
  const state = stateFile();
  state.connections = state.connections || {};
  state.connections[serviceId] = {
    ...(state.connections[serviceId] || {}),
    token_ref: `keyring:integration:${serviceId}`,
    auth_method: authMethod || null,
    access_mode: mode || "read",
    connected: true,
    updated_at: new Date().toISOString(),
  };
  writeState(state);
  audit("vault_put", { service: serviceId, auth_method: authMethod || null, mode: mode || "read", backend: "encrypted_file" });
  return state.connections[serviceId];
}

function deleteSecret(serviceId) {
  const enc = credentialsFile();
  const removed = delete enc[`integration:${serviceId}`];
  fs.writeFileSync(VAULT_CREDENTIALS, JSON.stringify(enc));
  const state = stateFile();
  if (state.connections && state.connections[serviceId]) {
    state.connections[serviceId] = { ...state.connections[serviceId], token_ref: undefined, connected: false };
    writeState(state);
  }
  audit("vault_delete", { service: serviceId, removed });
  return removed;
}

function loadSecret(serviceId) {
  const enc = credentialsFile();
  return enc[`integration:${serviceId}`]?.value ?? null;
}

// --- Catalog (service metadata from integrations.yaml, flattened) --------
function loadCatalog() {
  if (!fs.existsSync(CATALOG_PATH)) return [];
  try {
    const yaml = fs.readFileSync(CATALOG_PATH, "utf8");
    // minimal YAML parse: top-level "services:" list with id/name/category/auth_methods
    const services = [];
    let current = null;
    for (const line of yaml.split("\n")) {
      const trimmed = line.trim();
      if (/^-\s+id:/.test(trimmed)) {
        if (current) services.push(current);
        current = { id: trimmed.replace(/^-\s+id:\s*/, "").replace(/["']/g, "") };
      } else if (current && /^[a-z_]+:/.test(trimmed) && !trimmed.startsWith("- ")) {
        const [k, ...rest] = trimmed.split(":");
        const v = rest.join(":").trim().replace(/["']/g, "");
        if (k === "name") current.name = v;
        else if (k === "category") current.category = v;
        else if (k === "auth_methods") current.auth_methods = v.split(",").map((s) => s.trim()).filter(Boolean);
      }
    }
    if (current) services.push(current);
    return services;
  } catch {
    return [];
  }
}

function vaultStatus() {
  const enc = credentialsFile();
  const state = stateFile();
  const services = loadCatalog();
  const out = [];
  let secured = 0;
  let missing = 0;
  for (const svc of services) {
    const sid = svc.id;
    const secret = loadSecret(sid);
    const conn = state.connections?.[sid];
    const has = secret !== null && secret !== undefined && secret !== "";
    if (has) secured += 1; else missing += 1;
    out.push({
      id: sid,
      name: svc.name || sid,
      category: svc.category || "integration",
      auth_methods: svc.auth_methods || [],
      has_secret: has,
      backend: has ? "encrypted_file" : null,
      preview: has ? maskedPreview(secret) : "—",
      fingerprint: has ? fingerprint(secret) : null,
      mode: conn?.access_mode || "read",
      connected: Boolean(conn?.connected) && has,
    });
  }
  return {
    summary: {
      services_total: services.length,
      secured_total: secured,
      missing_total: missing,
      keyring_available: false,
      backend: "encrypted_file",
    },
    services: out,
  };
}

// --- HTTP helpers ----------------------------------------------------------
function readBody(req) {
  return new Promise((resolve, reject) => {
    let size = 0;
    const chunks = [];
    req.on("data", (c) => {
      size += c.length;
      if (size > MAX_BODY) {
        reject(new Error("payload too large"));
        req.destroy();
        return;
      }
      chunks.push(c);
    });
    req.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
    req.on("error", reject);
  });
}

function json(res, code, payload) {
  const body = JSON.stringify(payload);
  res.writeHead(code, {
    "Content-Type": "application/json; charset=utf-8",
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
  });
  res.end(body);
}

function sendFile(res, filePath) {
  let p = filePath;
  // Only serve from the plugin's static dir (no traversal).
  const root = path.resolve(STATIC_DIR);
  const resolved = path.resolve(p);
  if (!resolved.startsWith(root + path.sep) && resolved !== root) {
    json(res, 403, { error: { code: "forbidden", message: "path outside static root" } });
    return;
  }
  if (!fs.existsSync(resolved) || fs.statSync(resolved).isDirectory()) {
    json(res, 404, { error: { code: "not_found", message: "not found" } });
    return;
  }
  const ext = path.extname(resolved);
  const types = {
    ".html": "text/html; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".svg": "image/svg+xml",
    ".png": "image/png",
  };
  res.writeHead(200, {
    "Content-Type": types[ext] || "application/octet-stream",
    "Cache-Control": ext === ".html" ? "no-store" : "public, max-age=300",
    "X-Content-Type-Options": "nosniff",
  });
  fs.createReadStream(resolved).pipe(res);
}

// --- Plugin entry -----------------------------------------------------------
exports.register = (api) => {
  const logger = api.logger;

  api.registerHttpRoute({
    path: "/vault",
    auth: "plugin",
    match: "exact",
    handler: async (req, res) => {
      sendFile(res, path.join(STATIC_DIR, "index.html"));
      return true;
    },
  });

  api.registerHttpRoute({
    path: "/vault/static",
    auth: "plugin",
    match: "prefix",
    handler: async (req, res) => {
      const rel = req.url.split("?")[0].replace(/^\/vault\/static\//, "");
      sendFile(res, path.join(STATIC_DIR, rel));
      return true;
    },
  });

  api.registerHttpRoute({
    path: "/vault/api/status",
    auth: "plugin",
    match: "exact",
    handler: async (req, res) => {
      json(res, 200, vaultStatus());
      return true;
    },
  });

  api.registerHttpRoute({
    path: "/vault/api/put",
    auth: "plugin",
    match: "exact",
    handler: async (req, res) => {
      if (req.method !== "POST") {
        json(res, 405, { error: { code: "method_not_allowed" } });
        return true;
      }
      try {
        const body = JSON.parse(await readBody(req));
        const sid = String(body.service_id || "").trim();
        const secret = String(body.secret || "");
        if (!sid || !secret) {
          json(res, 400, { error: { code: "invalid_request", message: "service_id and secret are required" } });
          return true;
        }
        if (secret.length > 8192) {
          json(res, 413, { error: { code: "payload_too_large", message: "secret exceeds 8 KiB" } });
          return true;
        }
        const conn = storeSecret(sid, secret, body.auth_method, body.access_mode);
        // Never echo the secret back.
        json(res, 200, { ok: true, pointer: conn.token_ref, connection: { connected: true } });
      } catch (e) {
        json(res, 400, { error: { code: "invalid_request", message: e.message } });
      }
      return true;
    },
  });

  api.registerHttpRoute({
    path: "/vault/api/delete",
    auth: "plugin",
    match: "exact",
    handler: async (req, res) => {
      if (req.method !== "POST") {
        json(res, 405, { error: { code: "method_not_allowed" } });
        return true;
      }
      try {
        const body = JSON.parse(await readBody(req));
        const sid = String(body.service_id || "").trim();
        if (!sid) {
          json(res, 400, { error: { code: "invalid_request", message: "service_id is required" } });
          return true;
        }
        const removed = deleteSecret(sid);
        json(res, 200, { ok: true, service_id: sid, removed, disconnected: true });
      } catch (e) {
        json(res, 400, { error: { code: "invalid_request", message: e.message } });
      }
      return true;
    },
  });

  // Control UI sidebar tab — sandboxed iframe pointing at /vault/.
  api.registerControlUiDescriptor({
    surface: "tab",
    id: "vault",
    label: "Vault",
    description: "Secure secrets management for Substrate integrations",
    icon: "shield",
    path: "/vault/",
    group: "control",
    order: 90,
  });

  logger.info("Substrate Vault plugin loaded: /vault/ tab registered");
};
