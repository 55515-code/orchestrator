FROM docker.io/library/ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        jq \
        openssh-client \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        rsync \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.title="Local Substrate Toolbox"
LABEL org.opencontainers.image.description="Pinned general-purpose local build and automation environment"
LABEL org.opencontainers.image.source="work/local-substrate/Containerfile.toolbox"
LABEL org.opencontainers.image.version="2026.07"

WORKDIR /workspace
