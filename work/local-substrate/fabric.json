{
  "version": 1,
  "workspace_root": "/home/ahron/codespace",
  "policy": {
    "reserved_host_cpus": 4,
    "reserved_host_memory_gib": 8,
    "minimum_free_disk_gib": 80,
    "default_profile": "container-ubuntu",
    "privilege": "rootless-first",
    "host_escalation": "policykit-only"
  },
  "project_overrides": {
    "LuigiOS": "container-kvm",
    "aosp-eos-asteroids": "local-light",
    "batocera-emulationstation-upstream": "container-arch-build",
    "batocera-steamdeck-upstream": "container-arch-build",
    "open-provenance-knowledge": "container-ubuntu"
  },
  "profiles": {
    "local-light": {
      "backend": "local",
      "cpus": 4,
      "memory": "8G",
      "pids": 2048,
      "description": "Host tools and hardware access; systemd user scope limits."
    },
    "container-ubuntu": {
      "backend": "container",
      "image": "localhost/local-substrate-toolbox:2026.07",
      "cpus": 8,
      "memory": "16g",
      "pids": 4096,
      "network": "pasta",
      "description": "General disposable Linux workload."
    },
    "container-arch-build": {
      "backend": "container",
      "image": "docker.io/library/archlinux@sha256:33c534be6c990710a878b37192904dd448e162ade06a201d95a80b42be2110c7",
      "cpus": 12,
      "memory": "32g",
      "pids": 8192,
      "network": "pasta",
      "description": "Large compilation and package-building workload."
    },
    "container-kvm": {
      "backend": "container",
      "image": "localhost/luigios-qemu-runner@sha256:93cd246db1618fd6f66e36ff95f0a6eae040639ef725f7a44bc55d6d1c1238d1",
      "cpus": 12,
      "memory": "32g",
      "pids": 8192,
      "network": "none",
      "kvm": true,
      "description": "Offline full-system simulation nested inside a container."
    },
    "vm-rootless": {
      "backend": "vm",
      "uri": "qemu:///session",
      "name": "fabric-ubuntu",
      "ssh_host": "127.0.0.1",
      "ssh_port": 22222,
      "ssh_user": "fabric",
      "identity": "/home/ahron/.local/share/local-substrate/ssh/id_ed25519",
      "remote_root": "/home/fabric/workspaces",
      "cpus": 8,
      "memory": "16G",
      "pids": 8192,
      "description": "Rootless libvirt guest for kernel, init, firmware, and isolation work."
    }
  },
  "mcps": {
    "context7": {
      "backend": "container",
      "transport": "stdio",
      "image": "docker.io/library/node@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d",
      "cpus": 2,
      "memory": "2g",
      "pids": 512,
      "network": "pasta",
      "pass_env": ["DEFAULT_MINIMUM_TOKENS"],
      "command": ["npx", "-y", "@upstash/context7-mcp@3.2.5"],
      "description": "Documentation lookup MCP isolated from host Node/npm state."
    }
  }
}
